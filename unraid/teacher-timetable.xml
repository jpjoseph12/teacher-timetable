<?xml version="1.0"?>
<Container version="2">
  <Name>teacher-timetable</Name>
  <Repository>ghcr.io/jpjoseph12/teacher-timetable:latest</Repository>
  <Registry>https://github.com/jpjoseph12/teacher-timetable/pkgs/container/teacher-timetable</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/jpjoseph12/teacher-timetable</Support>
  <Project>https://github.com/jpjoseph12/teacher-timetable</Project>
  <Overview>Personal Harris timetable with per-class and per-lesson notes. Notes are stored in /data.</Overview>
  <Category>Productivity:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/jpjoseph12/teacher-timetable/main/public/icon-512.png</Icon>
  <Config Name="Web port" Target="8080" Default="8095" Mode="tcp" Description="Port the app is served on" Type="Port" Display="always" Required="true" Mask="false">8095</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/teacher-timetable" Mode="rw" Description="Database and session secret" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/teacher-timetable</Config>
  <Config Name="Password" Target="APP_PASSWORD" Default="" Mode="" Description="Password for signing in. Use a long one: the app is reachable from the internet." Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Time zone" Target="TZ" Default="Europe/London" Mode="" Description="Used to work out the current period" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/London</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID that owns the data folder" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID that owns the data folder" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
</Container>
